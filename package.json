{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build --workspace=@workspace/agenda-peluqueria",
    "start": "tsx server.ts",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs",
    "lint": "npm run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3",
    "express": "^5.2.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2"
  }
}
